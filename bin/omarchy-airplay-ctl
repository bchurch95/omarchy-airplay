#!/usr/bin/env bash

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
state_dir="${config_home}/omarchy-airplay"
target_file="${state_dir}/target.tsv"
firewall_file="${state_dir}/firewall.tsv"
credentials_file="${config_home}/doubletake/credentials.json"
active_route_file="${state_dir}/active_route.tsv"
known_file="${state_dir}/known_receivers.tsv"

fluxcast_bin() {
  if [[ -x "${script_dir}/fluxcast" ]]; then
    printf '%s\n' "${script_dir}/fluxcast"
  elif command -v fluxcast >/dev/null 2>&1; then
    command -v fluxcast
  else
    return 1
  fi
}

usage() {
  printf 'Usage: %s discover|load|save NAME ADDRESS [DEVICE_ID] [PROTOCOL]|clear|paired DEVICE_ID|forget DEVICE_ID|clear-restore DEVICE_ID|network|firewall-load DEVICE_ID|firewall-save DEVICE_ID ADDRESS PORT_RANGE|firewall-clear DEVICE_ID|ensure-route ADDRESS|clear-route [ADDRESS]|virtual-display-create|virtual-display-remove [NAME]|stop-stream\n' "$0" >&2
  exit 2
}

network() {
  local route iface gateway cidr connection type
  route="$(ip -4 route show default 2>/dev/null | head -n 1 || true)"
  iface="$(awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' <<<"$route")"
  gateway="$(awk '{ for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }' <<<"$route")"
  [[ -n "$iface" ]] || exit 1
  cidr="$(ip -o -4 addr show dev "$iface" scope global 2>/dev/null | awk '{ print $4; exit }')"
  type="$(nmcli -g GENERAL.TYPE device show "$iface" 2>/dev/null | head -n 1 || true)"
  connection="$(nmcli -g GENERAL.CONNECTION device show "$iface" 2>/dev/null | head -n 1 || true)"
  printf '%s\t%s\t%s\t%s\t%s\n' "$iface" "$type" "$connection" "$cidr" "$gateway"
}

validate_firewall_record() {
  [[ "$1" =~ ^[0-9A-Fa-f:]+$ ]] || { printf 'Invalid device ID\n' >&2; exit 2; }
  [[ "$2" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { printf 'Firewall rules require an IPv4 receiver address\n' >&2; exit 2; }
  [[ "$3" =~ ^[0-9]{1,5}-[0-9]{1,5}$ ]] || { printf 'Invalid UDP port range\n' >&2; exit 2; }
}

firewall_load() {
  [[ $# -eq 1 ]] || usage
  [[ -f "$firewall_file" ]] || exit 1
  awk -F'\t' -v device_id="$1" '$1 == device_id { print; exit }' "$firewall_file"
}

firewall_save() {
  [[ $# -eq 3 ]] || usage
  validate_firewall_record "$1" "$2" "$3"
  mkdir -p "$state_dir"
  umask 077
  local temporary
  temporary="$(mktemp "${state_dir}/firewall.XXXXXX")"
  if [[ -f "$firewall_file" ]]; then
    awk -F'\t' -v device_id="$1" '$1 != device_id { print }' "$firewall_file" >"$temporary"
  fi
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$temporary"
  mv "$temporary" "$firewall_file"
}

firewall_clear() {
  [[ $# -eq 1 ]] || usage
  [[ -f "$firewall_file" ]] || exit 0
  local temporary
  temporary="$(mktemp "${state_dir}/firewall.XXXXXX")"
  awk -F'\t' -v device_id="$1" '$1 != device_id { print }' "$firewall_file" >"$temporary"
  mv "$temporary" "$firewall_file"
}

ensure_route() {
  [[ $# -ge 1 ]] || usage
  local target="$1"
  stop_stream
  [[ "$target" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 0

  clear_route

  local route_dev
  route_dev="$(ip route get "$target" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"

  local lan_route lan_iface lan_gateway
  lan_route="$(ip -4 route show default 2>/dev/null | grep -E "dev (wl|en|eth)" | head -n 1 || true)"
  if [[ -z "$lan_route" ]]; then
    lan_route="$(ip -4 route show default 2>/dev/null | head -n 1 || true)"
  fi
  lan_iface="$(awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' <<<"$lan_route")"
  lan_gateway="$(awk '{ for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }' <<<"$lan_route")"

  if [[ -z "$lan_iface" || -z "$lan_gateway" ]]; then
    return 0
  fi

  if [[ "$route_dev" == "$lan_iface" ]]; then
    return 0
  fi

  local conn
  conn="$(nmcli -g GENERAL.CONNECTION device show "$lan_iface" 2>/dev/null | head -n 1 || true)"
  if [[ -n "$conn" ]]; then
    mkdir -p "$state_dir"
    printf '%s\t%s\t%s\t%s\n' "$conn" "$lan_iface" "$target" "$lan_gateway" > "$active_route_file"
    nmcli connection modify "$conn" +ipv4.routes "${target}/32 $lan_gateway" 2>/dev/null || true
    nmcli device reapply "$lan_iface" 2>/dev/null || true
  fi
}

clear_route() {
  local target_to_clear="${1:-}"
  if [[ -f "$active_route_file" ]]; then
    local conn lan_iface target lan_gateway
    IFS=$'\t' read -r conn lan_iface target lan_gateway < "$active_route_file" || true
    rm -f "$active_route_file"
    if [[ -n "${conn:-}" && -n "${target:-}" && -n "${lan_gateway:-}" ]]; then
      nmcli connection modify "$conn" -ipv4.routes "${target}/32 $lan_gateway" 2>/dev/null || true
      if [[ -n "${lan_iface:-}" ]]; then
        nmcli device reapply "$lan_iface" 2>/dev/null || true
      fi
    fi
  fi
  if [[ -n "$target_to_clear" && "$target_to_clear" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    local lan_route lan_iface lan_gateway conn
    lan_route="$(ip -4 route show default 2>/dev/null | grep -E "dev (wl|en|eth)" | head -n 1 || ip -4 route show default 2>/dev/null | head -n 1 || true)"
    lan_iface="$(awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' <<<"$lan_route")"
    lan_gateway="$(awk '{ for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }' <<<"$lan_route")"
    if [[ -n "$lan_iface" && -n "$lan_gateway" ]]; then
      conn="$(nmcli -g GENERAL.CONNECTION device show "$lan_iface" 2>/dev/null | head -n 1 || true)"
      if [[ -n "$conn" ]]; then
        nmcli connection modify "$conn" -ipv4.routes "${target_to_clear}/32 $lan_gateway" 2>/dev/null || true
        nmcli device reapply "$lan_iface" 2>/dev/null || true
      fi
    fi
  fi
}

virtual_display_create() {
  command -v hyprctl >/dev/null 2>&1 || {
    printf 'hyprctl is required for virtual displays\n' >&2
    exit 1
  }
  local existing
  existing="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.name | (startswith("VIRTUAL") or startswith("HEADLESS"))) | .name' | head -n 1)"
  if [[ -n "$existing" ]]; then
    printf '%s\n' "$existing"
    return 0
  fi
  hyprctl output create headless VIRTUAL-1 >/dev/null 2>&1 || {
    printf 'Failed to create headless display\n' >&2
    exit 1
  }
  local created
  created="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.name | (startswith("VIRTUAL") or startswith("HEADLESS"))) | .name' | head -n 1)"
  printf '%s\n' "${created:-VIRTUAL-1}"
}

virtual_display_remove() {
  command -v hyprctl >/dev/null 2>&1 || exit 0
  local target="${1:-}"
  if [[ -n "$target" ]]; then
    hyprctl output remove "$target" >/dev/null 2>&1 || true
  else
    hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.name | (startswith("VIRTUAL") or startswith("HEADLESS"))) | .name' | while read -r m; do
      [[ -n "$m" ]] && hyprctl output remove "$m" >/dev/null 2>&1 || true
    done
  fi
}

stop_stream() {
  killall doubletake 2>/dev/null || true
  pkill -f 'fluxcast.*main.py' 2>/dev/null || true
  killall -9 wf-recorder 2>/dev/null || true
  rm -rf /tmp/fluxcast/* 2>/dev/null || true
}

discover() {
  command -v avahi-browse >/dev/null 2>&1 || {
    printf 'avahi-browse is required (package: avahi)\n' >&2
    exit 127
  }

  local discovered
  discovered="$(
    # 1. Discover AirPlay video receivers (Apple TV, Mac, etc.)
    avahi-browse --resolve --terminate --parsable _airplay._tcp 2>/dev/null |
      awk -F';' '
        function unescape(value, result, code) {
          result = ""
          while (match(value, /\\[0-9][0-9][0-9]/)) {
            result = result substr(value, 1, RSTART - 1)
            code = substr(value, RSTART + 1, 3) + 0
            result = result sprintf("%c", code)
            value = substr(value, RSTART + 4)
          }
          return result value
        }
        $1 == "=" && $3 == "IPv4" && !seen[$8]++ {
          txt = $10
          if (txt ~ /model=AudioAccessory/ || txt ~ /features=0x[0-9A-Fa-f]*00,/ || txt ~ /manufacturer=Sonos/ || txt ~ /model=Shairport/)
            next
          name = unescape($4)
          device_id = ""
          if (match(txt, /deviceid=[0-9A-Fa-f:]+/))
            device_id = substr(txt, RSTART + 9, RLENGTH - 9)
          print name "\t" $8 "\t" device_id "\tairplay"
        }
      ' |
      while IFS=$'\t' read -r name address device_id protocol; do
        paired=0
        if [[ -n "$device_id" && -f "$credentials_file" ]] &&
          jq -e --arg device_id "$device_id" 'has($device_id)' "$credentials_file" >/dev/null 2>&1; then
          paired=1
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$address" "$device_id" "$paired" "$protocol"
      done

    # 2. Discover Google Cast / Chromecast receivers
    avahi-browse --resolve --terminate --parsable _googlecast._tcp 2>/dev/null |
      awk -F';' '
        function unescape(value, result, code) {
          result = ""
          while (match(value, /\\[0-9][0-9][0-9]/)) {
            result = result substr(value, 1, RSTART - 1)
            code = substr(value, RSTART + 1, 3) + 0
            result = result sprintf("%c", code)
            value = substr(value, RSTART + 4)
          }
          return result value
        }
        $1 == "=" && $3 == "IPv4" && !seen[$8]++ {
          txt = $10
          name = unescape($4)
          if (match(txt, /"fn=([^"]+)"/, m)) {
            name = m[1]
          } else if (match(txt, /fn=([^" ;]+)/, m)) {
            name = m[1]
          }
          print name "\t" $8 "\t" $8 "\t1\tcast"
        }
      '
  )" || true

  # Update known_file with newly discovered receivers
  mkdir -p "$state_dir"
  if [[ -n "$discovered" ]]; then
    while IFS=$'\t' read -r d_name d_addr d_did d_paired d_proto; do
      [[ -n "$d_addr" && "$d_proto" == "airplay" ]] || continue
      local temp_known
      temp_known="$(mktemp "${state_dir}/known.XXXXXX")"
      if [[ -f "$known_file" ]]; then
        awk -F'\t' -v addr="$d_addr" '$2 != addr { print }' "$known_file" >"$temp_known"
      fi
      printf '%s\t%s\t%s\t%s\n' "$d_name" "$d_addr" "$d_did" "$d_proto" >>"$temp_known"
      mv "$temp_known" "$known_file"
    done <<<"$discovered"
  fi

  # Probe known/saved receivers not seen in current mDNS broadcast (cross-VLAN Apple TVs)
  local candidate_file
  candidate_file="$(mktemp "${state_dir}/cand.XXXXXX")"
  if [[ -f "$known_file" ]]; then
    cat "$known_file" >> "$candidate_file"
  fi
  if [[ -f "$target_file" ]]; then
    awk -F'\t' '{ print $1 "\t" $2 "\t" $3 "\t" ($4 != "" ? $4 : "airplay") }' "$target_file" >> "$candidate_file"
  fi

  local probed_candidates=""
  if [[ -s "$candidate_file" ]]; then
    probed_candidates="$(python3 - "$candidate_file" "$credentials_file" "${discovered:-}" << 'EOF'
import sys, json, socket
from concurrent.futures import ThreadPoolExecutor

cand_file = sys.argv[1]
creds_file = sys.argv[2]
discovered_raw = sys.argv[3] if len(sys.argv) > 3 else ""

discovered_addrs = set()
for line in discovered_raw.splitlines():
    parts = line.split('\t')
    if len(parts) >= 2 and parts[1]:
        discovered_addrs.add(parts[1])

creds = {}
try:
    with open(creds_file, 'r') as f:
        creds = json.load(f)
except Exception:
    pass

candidates = []
seen = set(discovered_addrs)
try:
    with open(cand_file, 'r') as f:
        for line in f:
            parts = line.rstrip('\r\n').split('\t')
            if len(parts) >= 2:
                name, addr = parts[0], parts[1]
                did = parts[2] if len(parts) > 2 else ''
                proto = parts[3] if len(parts) > 3 else 'airplay'
                if addr and addr not in seen:
                    seen.add(addr)
                    candidates.append((name, addr, did, proto))
except Exception:
    pass

def probe(c):
    name, addr, did, proto = c
    try:
        port = 8009 if proto == 'cast' else 7000
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.4)
        s.connect((addr, port))
        s.close()
        paired = '1' if (proto == 'cast' or (did and did in creds)) else '0'
        return f"{name}\t{addr}\t{did}\t{paired}\t{proto}"
    except Exception:
        return None

if candidates:
    with ThreadPoolExecutor(max_workers=min(32, len(candidates))) as ex:
        for res in ex.map(probe, candidates):
            if res:
                print(res)
EOF
)" || true
  fi
  rm -f "$candidate_file"

  # 3. Discover Miracast / Wi-Fi Direct TVs (instant cached + background refresh)
  local wfd_cached=""
  local wfd_cache="/tmp/omarchy-wfd-peers.cache"
  if [[ -f "$wfd_cache" ]]; then
    wfd_cached="$(cat "$wfd_cache" 2>/dev/null || true)"
  fi

  # Combine and sort all discovered receivers:
  # Priority 1: Active route or saved target Apple TV
  # Priority 2: Other paired receivers
  # Priority 3: Other discovered receivers
  local active_addr=""
  if [[ -f "$active_route_file" ]]; then
    active_addr="$(awk -F'\t' 'NR==1 { print $2 }' "$active_route_file" 2>/dev/null || true)"
  elif [[ -f "$target_file" ]]; then
    active_addr="$(awk -F'\t' 'NR==1 { print $2 }' "$target_file" 2>/dev/null || true)"
  fi

  {
    [[ -z "$discovered" ]] || printf '%s\n' "$discovered"
    [[ -z "$probed_candidates" ]] || printf '%s\n' "$probed_candidates"
    [[ -z "$wfd_cached" ]] || printf '%s\n' "$wfd_cached"
  } | awk -F'\t' -v active="$active_addr" '
    NF >= 2 && !seen[$2]++ {
      priority = 3
      if (active != "" && $2 == active) {
        priority = 1
      } else if ($4 == "1") {
        priority = 2
      }
      print priority "\t" $0
    }
  ' | sort -t$'\t' -k1,1n -k2,2V | cut -f2-

  local fc
  if fc="$(fluxcast_bin)"; then
    (
      local out
      out="$("$fc" --wfd-scan --wfd-timeout 4 2>/dev/null | awk '
        match($0, /\[[0-9]+\]\s+([0-9A-Fa-f:]{17})\s+(.*)\s+via/, m) {
          bssid = m[1]
          name = m[2]
          gsub(/^\[TV\]\s*/, "", name)
          if (!seen[bssid]++) {
            print name "\t" bssid "\t" bssid "\t1\twfd"
          }
        }
      ')" || true
      if [[ -n "$out" ]]; then
        printf '%s\n' "$out" > "$wfd_cache"
      fi
    ) >/dev/null 2>&1 &
  fi
}

wfd_scan() {
  local timeout="${1:-4}"
  local wfd_cache="/tmp/omarchy-wfd-peers.cache"
  local output=""
  local fc
  if fc="$(fluxcast_bin)"; then
    output="$("$fc" --wfd-scan --wfd-timeout "$timeout" 2>/dev/null | awk '
      match($0, /\[[0-9]+\]\s+([0-9A-Fa-f:]{17})\s+(.*)\s+via/, m) {
        bssid = m[1]
        name = m[2]
        gsub(/^\[TV\]\s*/, "", name)
        if (!seen[bssid]++) {
          print name "\t" bssid "\t" bssid "\t1\twfd"
        }
      }
    ')" || true
    if [[ -n "$output" ]]; then
      printf '%s\n' "$output" > "$wfd_cache"
      printf '%s\n' "$output"
      return 0
    fi
  fi
  if [[ -f "$wfd_cache" ]]; then
    cat "$wfd_cache"
  fi
}

load_target() {
  if [[ -f "$target_file" ]]; then
    head -n 1 "$target_file"
  fi
}

save_target() {
  [[ $# -ge 2 && $# -le 4 ]] || usage
  local name="$1"
  local address="$2"
  local device_id="${3:-}"
  local protocol="${4:-airplay}"

  [[ -n "$name" && -n "$address" ]] || usage
  [[ "$name" != *$'\t'* && "$name" != *$'\n'* ]] || {
    printf 'Receiver name contains unsupported whitespace\n' >&2
    exit 2
  }
  [[ "$address" =~ ^[A-Za-z0-9._:-]+$ ]] || {
    printf 'Invalid receiver address\n' >&2
    exit 2
  }

  mkdir -p "$state_dir"
  umask 077
  local temporary
  temporary="$(mktemp "${state_dir}/target.XXXXXX")"
  printf '%s\t%s\t%s\t%s\n' "$name" "$address" "$device_id" "$protocol" >"$temporary"
  mv "$temporary" "$target_file"

  local k_temp
  k_temp="$(mktemp "${state_dir}/known.XXXXXX")"
  if [[ -f "$known_file" ]]; then
    awk -F'\t' -v addr="$address" '$2 != addr { print }' "$known_file" >"$k_temp"
  fi
  printf '%s\t%s\t%s\t%s\n' "$name" "$address" "$device_id" "$protocol" >>"$k_temp"
  mv "$k_temp" "$known_file"
}

paired() {
  [[ $# -eq 1 ]] || usage
  [[ -f "$credentials_file" ]] || exit 1
  jq -e --arg device_id "$1" 'has($device_id)' "$credentials_file" >/dev/null
}

forget() {
  [[ $# -eq 1 ]] || usage
  local target_to_forget="$1"

  if [[ -f "$known_file" ]]; then
    local k_temp
    k_temp="$(mktemp "${state_dir}/known.XXXXXX")"
    awk -F'\t' -v id="$target_to_forget" '$2 != id && $3 != id { print }' "$known_file" >"$k_temp"
    mv "$k_temp" "$known_file"
  fi

  if [[ -f "$target_file" ]]; then
    local t_name t_addr t_did
    IFS=$'\t' read -r t_name t_addr t_did < "$target_file" || true
    if [[ "${t_did:-}" == "$target_to_forget" || "${t_addr:-}" == "$target_to_forget" ]]; then
      rm -f "$target_file"
    fi
  fi

  [[ -f "$credentials_file" ]] || exit 0
  command -v jq >/dev/null 2>&1 || {
    printf 'jq is required to forget a receiver pairing\n' >&2
    exit 127
  }

  local temporary
  temporary="$(mktemp "${credentials_file}.XXXXXX")"
  jq --arg device_id "$target_to_forget" 'del(.[$device_id])' "$credentials_file" >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$credentials_file"
}

clear_restore() {
  [[ $# -eq 1 ]] || usage
  [[ -f "$credentials_file" ]] || exit 0
  command -v jq >/dev/null 2>&1 || {
    printf 'jq is required to clear a receiver capture selection\n' >&2
    exit 127
  }

  local temporary
  temporary="$(mktemp "${credentials_file}.XXXXXX")"
  jq --arg device_id "$1" 'if has($device_id) then .[$device_id] |= del(.restore_token) else . end' "$credentials_file" >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$credentials_file"
}

set_sink() {
  local target="${1:-airplay}"
  local target_sink=""
  mkdir -p "$state_dir"

  if [[ "$target" == "airplay" ]]; then
    if ! pactl list sinks short 2>/dev/null | grep -q "AirPlay"; then
      pactl load-module module-null-sink sink_name=AirPlay rate=44100 channels=2 sink_properties=device.description=AirPlay 2>/dev/null || true
    fi
    target_sink="AirPlay"
  elif [[ "$target" == "homepods" ]]; then
    if ! pactl list sinks short 2>/dev/null | grep -q "HomePods"; then
      pactl load-module module-null-sink sink_name=HomePods rate=44100 channels=2 sink_properties=device.description=HomePods 2>/dev/null || true
    fi
    target_sink="HomePods"
  else
    # Restore mode (returning from AirPlay/HomePods)
    # If card has disabled Speaker profile, switch to Speaker
    local card_id
    card_id="$(pactl list cards short 2>/dev/null | awk '$2 ~ /pci.*(skl_hda_dsp|sof)/ { print $1; exit }')"
    if [[ -n "$card_id" ]] && ! pactl list sinks short 2>/dev/null | grep -q "Speaker"; then
      pactl set-card-profile "$card_id" "HiFi (HDMI1, HDMI2, HDMI3, Mic1, Speaker)" 2>/dev/null || true
    fi

    # 1. First attempt: restore previous_sink if valid and not HDMI/easyeffects
    if [[ -f "${state_dir}/previous_sink" ]]; then
      local prev
      prev="$(head -n 1 "${state_dir}/previous_sink" 2>/dev/null || true)"
      if [[ -n "$prev" && "$prev" != "AirPlay" && "$prev" != "HomePods" && "$prev" != "easyeffects_sink" && "$prev" != *"HDMI"* ]]; then
        if pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -Fxq "$prev"; then
          target_sink="$prev"
        fi
      fi
    fi

    # 2. Second attempt: prioritize active Bluetooth audio devices
    if [[ -z "$target_sink" ]]; then
      target_sink="$(pactl list sinks short 2>/dev/null | awk '$2 ~ /^bluez_output\./ { print $2; exit }')"
    fi

    # 3. Third attempt: USB / Dock analog audio output
    if [[ -z "$target_sink" ]]; then
      target_sink="$(pactl list sinks short 2>/dev/null | awk '$2 ~ /^alsa_output\.usb.*analog/ { print $2; exit }')"
    fi

    # 4. Fourth attempt: Laptop internal speakers / analog output
    if [[ -z "$target_sink" ]]; then
      target_sink="$(pactl list sinks short 2>/dev/null | awk '$2 ~ /^alsa_output\.pci.*(Speaker|Headphones|analog)/ { print $2; exit }')"
    fi

    # 5. Fallback: Any non-virtual and non-HDMI sink
    if [[ -z "$target_sink" ]]; then
      target_sink="$(pactl list sinks short 2>/dev/null | awk '$2 !~ /HomePods|AirPlay|HDMI|easyeffects/ { print $2; exit }')"
    fi

    # 6. Final fallback: Any non-AirPlay/HomePods/easyeffects sink
    if [[ -z "$target_sink" ]]; then
      target_sink="$(pactl list sinks short 2>/dev/null | awk '$2 !~ /HomePods|AirPlay|easyeffects/ { print $2; exit }')"
    fi
  fi

  if [[ -n "$target_sink" ]]; then
    local current
    current="$(pactl get-default-sink 2>/dev/null || true)"
    if [[ "$target" != "default" && "$current" != "HomePods" && "$current" != "AirPlay" && "$current" != "easyeffects_sink" && "$current" != *"HDMI"* ]]; then
      printf '%s\n' "$current" > "${state_dir}/previous_sink"
    fi
    pactl set-default-sink "$target_sink" 2>/dev/null || true
    for input in $(pactl list sink-inputs short 2>/dev/null | cut -f1); do
      pactl move-sink-input "$input" "$target_sink" 2>/dev/null || true
    done

    # If restored to default and sink volume is muted or 0%, unmute and set sensible volume
    if [[ "$target" == "default" ]]; then
      rm -f "${state_dir}/previous_sink" 2>/dev/null || true
      local vol
      vol="$(pactl get-sink-volume "$target_sink" 2>/dev/null | grep -o '[0-9]\+%' | head -n 1 | tr -d '%' || echo "50")"
      if [[ -n "$vol" && "$vol" -le 0 ]]; then
        pactl set-sink-volume "$target_sink" 40% 2>/dev/null || true
      fi
      pactl set-sink-mute "$target_sink" 0 2>/dev/null || true
    fi
  fi
}

case "$1" in
  discover)
    [[ $# -eq 1 ]] || usage
    discover
    ;;
  load)
    [[ $# -eq 1 ]] || usage
    load_target
    ;;
  save)
    shift
    save_target "$@"
    ;;
  clear)
    [[ $# -eq 1 ]] || usage
    if [[ -f "$target_file" ]]; then
      rm -- "$target_file"
    fi
    ;;
  paired)
    shift
    paired "$@"
    ;;
  forget)
    shift
    forget "$@"
    ;;
  clear-restore)
    shift
    clear_restore "$@"
    ;;
  network)
    [[ $# -eq 1 ]] || usage
    network
    ;;
  firewall-load)
    shift
    firewall_load "$@"
    ;;
  firewall-save)
    shift
    firewall_save "$@"
    ;;
  firewall-clear)
    shift
    firewall_clear "$@"
    ;;
  set-sink)
    shift
    set_sink "$@"
    ;;
  wfd-scan)
    shift
    wfd_scan "$@"
    ;;
  ensure-route)
    shift
    ensure_route "$@"
    ;;
  clear-route)
    shift
    clear_route "$@"
    ;;
  virtual-display-create)
    shift
    virtual_display_create "$@"
    ;;
  virtual-display-remove)
    shift
    virtual_display_remove "$@"
    ;;
  stop-stream)
    stop_stream
    ;;
  *)
    usage
    ;;
esac
